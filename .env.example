# ─────────────────────────────────────────────────────────────────────────────
# Spendwise environment configuration
# Copy to `.env` for local dev. On Vercel, set these in Project Settings → Env.
# NEVER commit the filled-in .env.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string.
# - Local dev (Docker): postgresql://postgres:pass@localhost:5432/moneytracker
# - Vercel + Neon: use the POOLED connection string (host contains "-pooler"),
#   e.g. postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/moneytracker?sslmode=require"

# ── Gmail ingestion (OAuth 2.0) — shared app credentials (set once) ──────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web app).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must EXACTLY match an authorized redirect URI on the OAuth client.
# Local:  http://localhost:3000/api/auth/google/callback
# Vercel: https://<your-app>.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ── LLM categorization (Anthropic Claude) — optional ─────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ── Auth (REQUIRED) ──────────────────────────────────────────────────────────
# Signs the login session cookie. Use a long random string (e.g. `openssl rand -hex 32`).
# If this changes, everyone is logged out.
SESSION_SECRET="change-me-to-a-long-random-string"

# ── Ops ──────────────────────────────────────────────────────────────────────
# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""
# How many days back a Gmail sync reaches.
BACKFILL_DAYS="90"
