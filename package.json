{
  "name": "spendwise",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted personal expense tracker for Indian bank/UPI transactions",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "sync": "tsx scripts/sync.ts",
    "parse": "tsx scripts/parse.ts",
    "categorize": "tsx scripts/categorize.ts",
    "detect-subs": "tsx scripts/detect-subscriptions.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "reset-data": "tsx scripts/reset-data.ts",
    "dev:alt": "NEXT_DIST_DIR=.next-alt next dev",
    "renormalize": "tsx scripts/renormalize-merchants.ts",
    "dedupe": "tsx scripts/dedupe-transactions.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:admin": "tsx scripts/create-admin.ts",
    "db:admin-columns": "prisma db execute --file prisma/sql/2026-10-20-admin-columns.sql --schema prisma/schema.prisma",
    "db:notes": "prisma db execute --file prisma/sql/2026-10-28-notes.sql --schema prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3",
    "@prisma/client": "^6.1.0",
    "date-fns": "^4.1.0",
    "googleapis": "^144.0.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
